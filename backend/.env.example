# Copia este archivo como backend/.env y completa los valores. .env no se sube a Git.
# SECRET_KEY: genera una con
#   .venv/bin/python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=True
# Debe coincidir con POSTGRES_PASSWORD del .env de la raíz (docker-compose.yml).
# Con "docker compose --profile app" no se usa: Docker define su propia DATABASE_URL.
DATABASE_URL=postgres://nexolab:CLAVE@localhost:5433/nexolab
# Contraseña de los usuarios de demostración que crea el comando seed_demo.
DEMO_PASSWORD=
# Opcional. Equipos con historial propio necesarios para entrenar K-Means sin el modelo de Kaggle (D-33).
# RISK_MIN_OWN_HISTORY_DEVICES=30
# Opcional. Intentos de login fallidos antes de bloquear, y minutos de bloqueo (RN-25, D-46).
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
